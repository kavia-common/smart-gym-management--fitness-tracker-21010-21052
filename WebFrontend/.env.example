# Environment variables for WebFrontend (React CRA requires REACT_APP_ prefix)

# Feature flags
REACT_APP_FEATURE_AI_RECS=true
REACT_APP_FEATURE_NOTIFICATIONS=true
REACT_APP_USE_MOCK_API=true

# Mock API configuration
REACT_APP_MOCK_API_DELAY_MS=300

# Supabase configuration (optional; app will no-op if missing)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Site URL for auth email redirects (if integrating real Supabase auth)
REACT_APP_SITE_URL=http://localhost:3000
